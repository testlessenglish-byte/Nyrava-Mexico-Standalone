{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "eslint.config.js"],
  // Audit A4/A5: this list used to exclude the entire business-logic engine
  // (intelligence/, canonical/, ai/, agents/, execution/, plus ~25 named
  // .server.ts/.functions.ts files — ~226 of 540 src files, the majority of
  // the codebase) from typechecking entirely. Verified by running a full
  // tsc pass with every exclusion removed: ai/, agents/, execution/, and
  // every one of the named files had ZERO real type errors — the exclusion
  // was stale caution, not a real risk barrier. All of it is now checked
  // except this one file, which is excluded for a specific, documented
  // reason rather than blanket caution: acceptance.test.ts has 4 tests
  // (`it.skip`, see the comment at their describe block) quarantined
  // pending a team decision on an undecided report-gate design — until
  // that's resolved, the module/property references those tests describe
  // (REPORT_MUST_BE_TERMINAL_ENGINES, ReportGate.stillInFlight) don't exist
  // in execution-state.ts, so this file alone cannot typecheck clean.
  // Remove this exclusion in the same commit that resolves that decision.
  "exclude": ["src/lib/intelligence/__tests__/acceptance.test.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
